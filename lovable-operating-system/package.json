{
  "name": "lovable-operating-system",
  "version": "1.0.0",
  "description": "Centralized Lovable Skills + Knowledge Operating System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node",
    "validate": "ts-node scripts/validate-all.ts",
    "generate:skill": "ts-node generators/skill-scaffold.ts",
    "generate:knowledge": "ts-node generators/knowledge-scaffold.ts",
    "generate:design-system": "ts-node generators/design-system-scaffold.ts",
    "generate:template": "ts-node generators/template-scaffold.ts",
    "package:skill": "ts-node scripts/package-skill.ts",
    "dedupe": "ts-node scripts/detect-duplicates.ts",
    "normalize": "ts-node scripts/normalize-markdown.ts",
    "extract:metadata": "ts-node scripts/extract-metadata.ts",
    "classify": "ts-node scripts/classify-skills.ts",
    "ingest:save": "ts-node scripts/save-raw-source.ts",
    "ingest:index": "ts-node scripts/index-sources.ts",
    "scaffold:folders": "ts-node scripts/scaffold-folders.ts",
    "format:imports": "ts-node scripts/format-imports.ts",
