# Command Center Configuration
# Copy this file to .env and fill in your keys

# Instagram (developers.facebook.com/tools/explorer)
IG_ACCESS_TOKEN=IGAA...
# IG_ACCOUNT_ID=17841400...

# Competitor Tracking via Apify (apify.com → Settings → Integrations)
APIFY_TOKEN=apify_api_...
COMPETITORS=handle1,handle2,handle3

# Google (set GOOGLE_ENABLED=true after running: gws auth login)
GOOGLE_ENABLED=true
USER_EMAIL=you@gmail.com

# AI News (tavily.com)
TAVILY_API_KEY=tvly-...
